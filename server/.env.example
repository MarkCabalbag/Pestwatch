# Copy this file to .env and adjust.

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP default (root, no password):
DATABASE_URL="mysql://root@localhost:3306/pest_monitor"
# With a password:
# DATABASE_URL="mysql://root:yourpassword@localhost:3306/pest_monitor"

# Long random string used to sign the login cookie
SESSION_SECRET="change-me-to-a-long-random-string"

PORT=3000
